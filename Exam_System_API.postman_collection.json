{
	"info": {
		"name": "在线考试系统 API",
		"description": "Spring Boot 3 + Vue 3 在线考试系统后端接口集合",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "用户认证",
			"item": [
				{
					"name": "用户登录",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"teacher\",\n    \"password\": \"123456\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/user/login", "host": ["{{baseUrl}}"], "path": ["api", "user", "login"]},
						"description": "教师登录: teacher/123456\n学生登录: student/123456\n管理员登录: admin/admin123"
					}
				},
				{
					"name": "用户注册",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"newstudent\",\n    \"password\": \"123456\",\n    \"role\": 0\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/user/register", "host": ["{{baseUrl}}"], "path": ["api", "user", "register"]}
					}
				},
				{
					"name": "修改密码",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"oldPassword\": \"123456\",\n    \"newPassword\": \"654321\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/user/change-password", "host": ["{{baseUrl}}"], "path": ["api", "user", "change-password"]}
					}
				}
			]
		},
		{
			"name": "题库管理",
			"item": [
				{
					"name": "分页查询题目",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/question/page?page=1&size=10&subjectName=Java程序设计&type=1",
							"host": ["{{baseUrl}}"], "path": ["api", "question", "page"],
							"query": [
								{"key": "page", "value": "1"}, {"key": "size", "value": "10"},
								{"key": "subjectName", "value": "Java程序设计"}, {"key": "type", "value": "1"}
							]
						},
						"description": "type: 1-单选, 2-多选, 3-判断, 4-主观"
					}
				},
				{
					"name": "获取所有科目",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/question/subjects", "host": ["{{baseUrl}}"], "path": ["api", "question", "subjects"]}
					}
				},
				{
					"name": "保存题目",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"subjectName\": \"Java程序设计\",\n    \"type\": 1,\n    \"content\": \"{\\\"title\\\":\\\"测试题目\\\",\\\"options\\\":[{\\\"value\\\":\\\"A\\\",\\\"label\\\":\\\"选项1\\\"},{\\\"value\\\":\\\"B\\\",\\\"label\\\":\\\"选项2\\\"}]}\",\n    \"standardAnswer\": \"A\",\n    \"score\": 5,\n    \"difficulty\": 0.3\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/question/save", "host": ["{{baseUrl}}"], "path": ["api", "question", "save"]},
						"description": "新增或修改题目（有id则修改）"
					}
				},
				{
					"name": "删除题目",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/question/1000001", "host": ["{{baseUrl}}"], "path": ["api", "question", "1000001"]}
					}
				},
				{
					"name": "导入题目(Excel)",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": []}]},
						"url": {"raw": "{{baseUrl}}/api/question/import", "host": ["{{baseUrl}}"], "path": ["api", "question", "import"]}
					}
				},
				{
					"name": "下载导入模板",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/question/template", "host": ["{{baseUrl}}"], "path": ["api", "question", "template"]}
					}
				}
			]
		},
		{
			"name": "试卷管理",
			"item": [
				{
					"name": "分页查询试卷",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/paper/page?page=1&size=10",
							"host": ["{{baseUrl}}"], "path": ["api", "paper", "page"],
							"query": [{"key": "page", "value": "1"}, {"key": "size", "value": "10"}]
						}
					}
				},
				{
					"name": "智能组卷",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Java程序设计-智能组卷\",\n    \"subjectName\": \"Java程序设计\",\n    \"totalScore\": 100,\n    \"targetDifficulty\": 0.5,\n    \"singleChoiceCount\": 10,\n    \"singleChoiceScore\": 2,\n    \"multiChoiceCount\": 5,\n    \"multiChoiceScore\": 4,\n    \"subjectiveCount\": 3,\n    \"subjectiveScore\": 10,\n    \"startTime\": \"2026-06-01 09:00:00\",\n    \"endTime\": \"2026-06-01 11:00:00\",\n    \"classIds\": [2001, 2002]\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/paper/auto-create", "host": ["{{baseUrl}}"], "path": ["api", "paper", "auto-create"]},
						"description": "遗传算法智能组卷，classIds 为分配的班级ID"
					}
				},
				{
					"name": "手动组卷",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paper\": {\n        \"title\": \"手动组卷测试\",\n        \"subjectName\": \"Java程序设计\",\n        \"totalScore\": 50,\n        \"startTime\": \"2026-06-01 14:00:00\",\n        \"endTime\": \"2026-06-01 16:00:00\"\n    },\n    \"questionIds\": [1000001, 1000002, 1000003],\n    \"classIds\": [2001]\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/paper/manual-create", "host": ["{{baseUrl}}"], "path": ["api", "paper", "manual-create"]},
						"description": "手动选择题目组卷，classIds 为分配的班级ID"
					}
				},
				{
					"name": "试卷归档",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/paper/archive/1001", "host": ["{{baseUrl}}"], "path": ["api", "paper", "archive", "1001"]}
					}
				},
				{
					"name": "更新试卷",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"修改后的试卷名称\",\n    \"totalScore\": 100\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/paper/1001", "host": ["{{baseUrl}}"], "path": ["api", "paper", "1001"]}
					}
				},
				{
					"name": "删除试卷",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/paper/1001", "host": ["{{baseUrl}}"], "path": ["api", "paper", "1001"]}
					}
				},
				{
					"name": "获取可考试卷(学生)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/paper/list-active", "host": ["{{baseUrl}}"], "path": ["api", "paper", "list-active"]}
					}
				},
				{
					"name": "活跃题目集(学生)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/paper/active", "host": ["{{baseUrl}}"], "path": ["api", "paper", "active"]},
						"description": "获取进行中的试卷（含倒计时）"
					}
				},
				{
					"name": "所有题目集(学生)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/paper/all?page=1&size=10",
							"host": ["{{baseUrl}}"], "path": ["api", "paper", "all"],
							"query": [{"key": "page", "value": "1"}, {"key": "size", "value": "10"}]
						},
						"description": "获取所有试卷（含分页）"
					}
				},
				{
					"name": "获取试卷详情",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/paper/detail/1001", "host": ["{{baseUrl}}"], "path": ["api", "paper", "detail", "1001"]},
						"description": "获取试卷详情（含题目列表）"
					}
				}
			]
		},
		{
			"name": "考试记录",
			"item": [
				{
					"name": "检查考试状态",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/record/check/1001", "host": ["{{baseUrl}}"], "path": ["api", "record", "check", "1001"]},
						"description": "检查学生对某试卷的考试状态"
					}
				},
				{
					"name": "提交试卷(交卷)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"paperId\": 1001,\n    \"answers\": [\n        {\"questionId\": 1000001, \"answer\": \"C\"},\n        {\"questionId\": 1000002, \"answer\": \"A,C\"},\n        {\"questionId\": 1000020, \"answer\": \"二叉树的遍历方式包括前序遍历、中序遍历和后序遍历\"}\n    ]\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/record/submit", "host": ["{{baseUrl}}"], "path": ["api", "record", "submit"]},
						"description": "交卷（自动判分：客观题精确匹配，主观题NLP余弦相似度）"
					}
				},
				{
					"name": "我的考试记录",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/record/my-records", "host": ["{{baseUrl}}"], "path": ["api", "record", "my-records"]}
					}
				},
				{
					"name": "成绩详情",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/record/detail/1001", "host": ["{{baseUrl}}"], "path": ["api", "record", "detail", "1001"]},
						"description": "获取成绩详情（含AI判分依据）"
					}
				},
				{
					"name": "试卷成绩列表(教师)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/record/list/1001", "host": ["{{baseUrl}}"], "path": ["api", "record", "list", "1001"]}
					}
				},
				{
					"name": "导出成绩(Excel)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/record/export/1001", "host": ["{{baseUrl}}"], "path": ["api", "record", "export", "1001"]},
						"description": "导出指定试卷成绩为Excel"
					}
				}
			]
		},
		{
			"name": "班级管理",
			"item": [
				{
					"name": "教师班级列表",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/class/list", "host": ["{{baseUrl}}"], "path": ["api", "class", "list"]}
					}
				},
				{
					"name": "创建班级",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"className\": \"Java程序设计2024春季班\",\n    \"description\": \"Java程序设计课程班级\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/class/create", "host": ["{{baseUrl}}"], "path": ["api", "class", "create"]}
					}
				},
				{
					"name": "更新班级",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"className\": \"修改后的班级名称\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/class/2001", "host": ["{{baseUrl}}"], "path": ["api", "class", "2001"]}
					}
				},
				{
					"name": "删除班级",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/class/2001", "host": ["{{baseUrl}}"], "path": ["api", "class", "2001"]}
					}
				},
				{
					"name": "班级详情",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/class/2001", "host": ["{{baseUrl}}"], "path": ["api", "class", "2001"]},
						"description": "获取班级详情（含学生列表）"
					}
				},
				{
					"name": "添加学生到班级",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "[1002, 1004, 1005]"
						},
						"url": {"raw": "{{baseUrl}}/api/class/2001/students", "host": ["{{baseUrl}}"], "path": ["api", "class", "2001", "students"]},
						"description": "批量添加学生到班级"
					}
				},
				{
					"name": "从班级移除学生",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/class/2001/students/1002", "host": ["{{baseUrl}}"], "path": ["api", "class", "2001", "students", "1002"]}
					}
				},
				{
					"name": "学生班级列表",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/class/student/list", "host": ["{{baseUrl}}"], "path": ["api", "class", "student", "list"]},
						"description": "学生获取自己加入的班级列表"
					}
				}
			]
		},
		{
			"name": "用户管理(管理员)",
			"item": [
				{
					"name": "学生列表",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/admin/students?page=1&size=10&keyword=",
							"host": ["{{baseUrl}}"], "path": ["api", "admin", "students"],
							"query": [
								{"key": "page", "value": "1"}, {"key": "size", "value": "10"}, {"key": "keyword", "value": ""}
							]
						}
					}
				},
				{
					"name": "所有学生(下拉选择用)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/admin/students/all", "host": ["{{baseUrl}}"], "path": ["api", "admin", "students", "all"]}
					}
				},
				{
					"name": "禁用/启用用户",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/1002/status?status=0",
							"host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "1002", "status"],
							"query": [{"key": "status", "value": "0"}]
						},
						"description": "status: 0-禁用, 1-启用"
					}
				},
				{
					"name": "重置密码",
					"request": {
						"method": "PUT",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/admin/users/1002/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "1002", "reset-password"]},
						"description": "重置密码为 123456"
					}
				},
				{
					"name": "删除用户",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/admin/users/1002", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "1002"]}
					}
				},
				{
					"name": "批量导入学生(Excel)",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": []}]},
						"url": {"raw": "{{baseUrl}}/api/admin/students/import", "host": ["{{baseUrl}}"], "path": ["api", "admin", "students", "import"]},
						"description": "Excel模板格式：用户名、密码、真实姓名、学号、手机号、邮箱、班级"
					}
				},
				{
					"name": "下载学生导入模板",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/admin/students/template", "host": ["{{baseUrl}}"], "path": ["api", "admin", "students", "template"]}
					}
				}
			]
		},
		{
			"name": "统计分析",
			"item": [
				{
					"name": "仪表盘数据",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/api/statistics/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "statistics", "dashboard"]}
					}
				}
			]
		}
	],
	"variable": [
		{"key": "baseUrl", "value": "http://localhost:8080", "type": "string"},
		{"key": "token", "value": "your_jwt_token_here", "type": "string"}
	]
}
